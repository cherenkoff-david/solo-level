{
  "name": "solo-level",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --test \"packages/domain/test/**/*.test.ts\" \"packages/finance/test/**/*.test.ts\" \"packages/app/test/**/*.test.ts\"",
    "gen:progression": "node scripts/gen-progression.ts",
    "dev": "npm run dev --workspace=@solo/app",
    "dev:docker": "docker compose -f docker-compose.dev.yml up --build",
    "dev:docker:detach": "docker compose -f docker-compose.dev.yml up --build -d",
    "dev:docker:stop": "docker compose -f docker-compose.dev.yml down",
    "dev:docker:reset": "docker compose -f docker-compose.dev.yml down -v",
    "typecheck": "npm run typecheck --workspace=@solo/app",
    "build": "npm run build --workspace=@solo/app",
    "db:start": "SUPABASE_USE_SLIM_IMAGES=true supabase start -x realtime,storage-api,edge-runtime,logflare,vector",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:new": "supabase migration new",
    "db:diff": "supabase db diff",
    "db:link": "supabase link",
    "db:push": "supabase db push",
    "db:start:full": "supabase start"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "supabase": "^3.1.0"
  }
}
